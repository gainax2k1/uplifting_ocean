[sub_resource type="Resource" id="Resource_k0ep2"]
script = ExtResource("1_ratjg")
NPC_Name = "Starfish"
NPC_Icon = "starfish-icon-ani "
Dialogs = Array[String](["Hello! I'm Starry! It looks like you had a pretty traumatic experience, what with your sub sinking and all..", "After all that, you're probably feeling pretty anxious and overwhelmed.", "When I feel like I need help dealing with those feelings, I like to follow the \"5-4-3-2-1 Technique\".  Let's try it together! There's no rush, just let me know when you've done each step.", "5 - What are 5 things you can see? It can be something small, or maybe a detail of something big.", "4 - What are 4 things you can feel? Maybe it's how your clothing feels, the chair you're sitting in, or the temperature of the air around you. ", "3 - What are 3 things you can hear? Try to hear things you migh normally ignore, like the sound of fan blowing, or ticking of a clock.", "2 - What are 2 things you can smell? It can just be in the air around you, like air freshener. Or you can try something like a plant that has a scent.", "1 - What is 1 thing you can taste? Maybe try a piece of candy, or the sip of a beveridge.", "I like this technique because it's so easy to remember! \"5-4-3-2-1\", like the points on your buddy Starry, hehe... I bet I can even help you with that lil' hole on your sub there, too! Have a starry day! <3"])
metadata/_custom_type_script = "uid://cmfv4wy4eohe4"

[sub_resource type="Resource" id="Resource_h456a"]
script = ExtResource("1_ratjg")
NPC_Name = "Eel"
NPC_Icon = "eel-icon-ani"
Dialogs = Array[String](["HELLO!", "YOU LOOK A LITTL LOW ON ENERGY!", "THIS MIGHT \"SHOCK\" YOU, BUT I CAN HELP YOU!", "shake themselves to release the excess energy produced from the stress response. Allowing your body to connect with the trembling sensation produced by a stressful event can enable your system to settle.", "stand up, and move your body arround, disregarding what others might think. ", "Move however feels natural, like dancing, wiggling all over, or shaking your arms.", "As you're doing this, think about what emotions this makes you feel, and how they feel.", "Sometimes, even clenching your fists and releasing them, or gently stomping your feet can do the job.", "Now i feel all \"charged\" up, let me share some of my energy with you and recharge that submarine for you!"])
metadata/_custom_type_script = "uid://cmfv4wy4eohe4"

[sub_resource type="Resource" id="Resource_nbxii"]
script = ExtResource("1_ratjg")
NPC_Name = "Puffer"
NPC_Icon = "puffer-icon-ani"
Dialogs = Array[String](["Heyo! My name's Puffy! ", "Breathing underwater is important, and I'm REALLY good at breathing excercises!", "They can be really helpful when feeling anxious or over whelmed.", "The special trick is to breath with your belly!", "Get yourself comfortable, then breath in through your nose, allowing your belly to expand, and hold it for a moment.", "Then, slooowly release it, like you're blowing through a straw. Feel the sensations in your body as you do it.", "Go ahead and do it a few more times, no rush!", "Great job! It can really help lift your spirits.  Now that I'm all puffed up, I can help lift you up! Let's goooo!"])
metadata/_custom_type_script = "uid://cmfv4wy4eohe4"

[resource]
